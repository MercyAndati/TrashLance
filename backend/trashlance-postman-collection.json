            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceProvider\": \"{{userId}}\",\n  \"service\": \"{{serviceId}}\",\n  \"scheduledDate\": \"2024-02-01\",\n  \"timeSlot\": {\n    \"start\": \"09:00\",\n    \"end\": \"10:00\"\n  },\n  \"location\": {\n    \"address\": {\n      \"street\": \"123 Test Street\",\n      \"city\": \"Nairobi\",\n      \"state\": \"Nairobi\",\n      \"zipCode\": \"00100\",\n      \"country\": \"Kenya\"\n    },\n    \"coordinates\": {\n      \"latitude\": -1.2921,\n      \"longitude\": 36.8219\n    }\n  },\n  \"serviceDetails\": {\n    \"wasteType\": [\"general\"],\n    \"estimatedWeight\": 50,\n    \"additionalNotes\": \"Please call when you arrive\"\n  },\n  \"pricing\": {\n    \"baseAmount\": 500,\n    \"totalAmount\": 500\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
