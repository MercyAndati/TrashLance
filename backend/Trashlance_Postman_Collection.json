              "raw": "{\n  \"name\": \"Residential Waste Pickup\",\n  \"description\": \"Weekly residential waste collection service\",\n  \"category\": \"residential_pickup\",\n  \"pricing\": {\n    \"type\": \"fixed\",\n    \"basePrice\": 25.00,\n    \"unit\": \"service\"\n  },\n  \"duration\": {\n    \"estimated\": 30\n  },\n  \"availability\": {\n    \"days\": [\"monday\", \"tuesday\", \"wednesday\", \"thursday\", \"friday\"],\n    \"timeSlots\": [\n      {\n        \"start\": \"08:00\",\n        \"end\": \"17:00\",\n        \"maxBookings\": 10\n      }\n    ]\n  },\n  \"serviceArea\": {\n    \"type\": \"radius\",\n    \"radius\": 25,\n    \"coordinates\": {\n      \"latitude\": 40.7128,\n      \"longitude\": -74.0060\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/services",
              "host": ["{{base_url}}"],
              "path": ["services"]
